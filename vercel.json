{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico|manifest.json).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 25,
      "includeFiles": "data/**"
    }
  }
}
